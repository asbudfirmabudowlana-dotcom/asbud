# Local API configuration. Copy this file to .env and fill in your own values.
DATABASE_URL=sqlite:///./buildsmart-dev.db
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
GUS_REGON_API_KEY=
# Optional: replace only when GUS provides a different BIR endpoint for your account.
GUS_REGON_ENDPOINT=https://wyszukiwarkaregon.stat.gov.pl/wsBIR/UslugaBIRzewnPubl.svc
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PROFESSIONAL=
APP_BASE_URL=http://localhost:8000
